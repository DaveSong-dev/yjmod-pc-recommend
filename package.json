{
  "name": "yjmod-recommend-page",
  "private": true,
  "scripts": {
    "dev": "python -m http.server 4173 --bind 127.0.0.1",
    "build": "npm run build:tailwind && python scripts/export_single_html.py",
    "build:tailwind": "tailwindcss -c tailwind.config.js -i ./css/tailwind.input.css -o ./css/tailwind.generated.css --minify",
    "analyze": "node scripts/analyze-bundle.mjs",
    "qa:wizard-scroll": "node scripts/qa-wizard-scroll.mjs",
    "qa:conversion": "node scripts/qa-conversion-flow.mjs",
    "qa:file": "node scripts/qa-file-flow.mjs",
    "qa:all": "npm run qa:wizard-scroll && npm run qa:conversion && npm run qa:file",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File .\\scripts\\deploy_vercel.ps1"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0",
    "@vercel/blob": "^0.27.3"
  }
}
